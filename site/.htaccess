# ═══════════════════════════════════════════════════════════════
# ExoTradingPlus! .htaccess LWS
# Posé le 11/08/2026 (T-052 §5). Contexte et recette de test dans la fiche.
# ROLLBACK : supprimer ce fichier suffit à tout annuler, sans autre effet.
# ═══════════════════════════════════════════════════════════════

Options -Indexes

RewriteEngine On

# ── www → apex ────────────────────────────────────────────────
# Cette règle passe AVANT la redirection HTTPS, et pas après : comme elle
# écrit déjà https:// dans sa cible, http://www.exemple.com arrive sur
# https://exemple.com en UN seul saut au lieu de deux.
# Le host n'est pas codé en dur : la règle vaut aussi pour
# exotradingplus.xyz, qui sert le même site sur la même IP.
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# ── Forcer HTTPS ──────────────────────────────────────────────
# Avant ce fichier, http://exotradingplus.com répondait 200 en clair sur un
# site qui porte l'authentification et le paiement.
# Les 3 conditions couvrent le cas où LWS termine le TLS sur un proxy et
# transmet la requête en clair à Apache : sans elles, boucle de redirection.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteCond %{HTTP:X-Forwarded-SSL} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

<IfModule mod_headers.c>

  # HSTS envoyé sans condition : un navigateur ignore l'en-tête reçu en clair,
  # donc c'est sans effet en HTTP, et ça évite de dépendre de la variable
  # HTTPS qui est absente quand le TLS est terminé en amont.
  # Ni includeSubDomains ni preload tant que tous les sous-domaines ne sont
  # pas en HTTPS : ces deux options sont très difficiles à annuler.
  Header always set Strict-Transport-Security "max-age=31536000"

  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"

  # CSP construite depuis l'inventaire réel des origines chargées le 11/08 :
  #   scripts  unpkg (lucide), jsdelivr, cdnjs
  #   styles   fonts.googleapis  ·  polices  fonts.gstatic
  #   données  Supabase (https + wss pour le realtime), n8n.romainben.cloud
  #            (webhook oia/sync du tracker)
  # Stripe, Discord, YouTube et Vercel sont des liens <a> vers l'extérieur,
  # pas des ressources chargées : ils n'ont rien à faire dans cette CSP.
  # payment=() plus haut est sans risque pour la même raison : le paiement
  # passe par une navigation vers buy.stripe.com, pas par l'API Payment Request.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https:; media-src 'self'; connect-src 'self' https://vlxdsrqxnvdbqjevqntb.supabase.co wss://vlxdsrqxnvdbqjevqntb.supabase.co https://n8n.romainben.cloud; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://buy.stripe.com; object-src 'none'; upgrade-insecure-requests"

</IfModule>
